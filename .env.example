# Production on Vercel: use Turso/libSQL.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=replace-with-your-turso-token

# Optional PostgreSQL fallback. Omit when TURSO_DATABASE_URL is set.
DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
POSTGRES_CONNECTION_TIMEOUT_MS=30000

# Optional local SQLite path when no remote database URL is set.
JOGASTOP_DATABASE_PATH=data/jogastop.db

# Protects POST /api/maintenance/cleanup.
MAINTENANCE_SECRET=replace-with-a-long-random-secret
# Protects the daily GET invoked automatically by Vercel Cron.
CRON_SECRET=replace-with-another-long-random-secret
# Protects /admin. Prefer a password you can type manually in the panel.
ADMIN_PASSWORD=replace-with-a-private-admin-password

# Retention and opportunistic cleanup intervals.
ROOM_RETENTION_ACTIVE_HOURS=24
ROOM_RETENTION_FINISHED_HOURS=168
ROOM_CLEANUP_INTERVAL_MINUTES=15

# Voice chat (LiveKit Cloud: https://cloud.livekit.io → Settings → Keys).
# Leave empty to hide the voice button.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret

# How often each server instance checks the database for room changes made
# by other instances (Server-Sent Events). Default 1500 ms, minimum 250 ms.
ROOM_REALTIME_WATCH_INTERVAL_MS=1500

# AdSense display ad units for the home page (AdSense → Ads → By ad unit).
# A missing value hides that ad block.
NEXT_PUBLIC_ADSENSE_SLOT_HOME_MIDDLE=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_BOTTOM=
